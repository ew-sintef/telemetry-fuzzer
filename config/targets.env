# Defaults used by fuzzing_scripts/run_fuzz.sh if present

# Global default target IP
DEFAULT_TARGET_IP=192.168.1.1

# Per-service ports (optional; run_fuzz.sh falls back to standard ports if not set)
DEFAULT_HTTP_PORT=80
DEFAULT_DNS_PORT=53
DEFAULT_SSH_PORT=22
DEFAULT_SIP_PORT=5060
DEFAULT_IPERF_PORT=5001

